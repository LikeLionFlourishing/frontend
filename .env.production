# 실서버 연동 빌드(`npm run build`)용. Vite 는 production 모드에서 이 파일을 읽는다.
# 여기 값은 전부 공개값이다(브라우저에 그대로 나감). 그래서 커밋해도 안전하다.
#
# 로컬에서 `npm run build` 를 돌리면 .env.local 이 이 파일을 덮어써서 MSW 가 켜질 수 있다.
# Vercel 빌드에는 .env.local 이 없으므로(gitignore) 이 값들이 그대로 쓰인다.

# API 오리진. 비우면 same-origin `/v1`(dev 프록시·mock)로 떨어진다.
VITE_API_ORIGIN=https://api.flourishing.o-r.kr

# Web Push VAPID 공개키. 백엔드 개인키와 같은 쌍이어야 알림이 온다.
VITE_VAPID_PUBLIC_KEY=BJiotWjA2PUpSFutq8gF4YFMhhIfVZGAhVhuG4_UVEP2Wd8bzcOGsNLoc6jRzrwFM7NDG1DRTtcJS9Qm3lLat1M
