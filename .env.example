# 백엔드 개발 서버 주소. dev 에서는 vite proxy 가 /v1 을 여기로 넘긴다.
VITE_API_PROXY_TARGET=http://localhost:8080

# MSW 목 서버 사용 여부. 백엔드가 아직 없으면 true.
VITE_USE_MSW=true

# Web Push VAPID 공개키(base64url). 백엔드에서 받아 넣는다.
# 계약에 이 값을 내려주는 엔드포인트가 없어서 빌드 환경변수로 받는다.
# 비어 있으면 알림 설정의 `알림 받기` 를 켤 수 없다(구독을 만들 수 없어서).
VITE_VAPID_PUBLIC_KEY=

# 로컬에서 배포된 실백엔드로 붙여 테스트할 때만 쓴다.
# 실백엔드는 상태변경 요청의 Origin 을 검사하므로, 프록시가 보내는 Origin 을
# 배포 도메인으로 갈아끼워야 로그인·저장이 통과한다. (비우면 갈아끼우지 않음)
#   VITE_USE_MSW=false
#   VITE_API_PROXY_TARGET=https://api.flourishing.o-r.kr
#   VITE_DEV_PROXY_ORIGIN=https://flourishing.o-r.kr
VITE_DEV_PROXY_ORIGIN=
